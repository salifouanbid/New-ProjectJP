+function bulletinTerm(req) {
+  const terms = db.prepare("SELECT id FROM terms WHERE school_id = ? AND status != 'upcoming' ORDER BY position").all(S(req));
+  const wanted = intOrNull(req.query.term_id);
+  const open = db.prepare("SELECT id FROM terms WHERE school_id = ? AND status = 'open'").get(S(req));
