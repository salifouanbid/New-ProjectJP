+++ b/scripts/preview-bulletin.js
@@ -0,0 +1,25 @@
+// Aperçu rapide du bulletin : génère data/apercu-bulletin.pdf SANS lancer le site ni cliquer dans l'interface.
+// Usage : npm run bulletin:preview            (premier élève ayant des notes)
+//         npm run bulletin:preview -- 5       (élève numéro 5 = colonne id de la table students)
+// Modifie src/services/pdf.js, relance la commande, ouvre le PDF : boucle de travail de 5 secondes.
+const fs = require('fs');
+const path = require('path');
+const db = require('../src/db');
+const config = require('../src/config');
+const { buildReport } = require('../src/services/reports');
+const { createBulletinDoc } = require('../src/services/pdf');
+
+const wanted = parseInt(process.argv[2], 10);
+const row = Number.isInteger(wanted)
+  ? db.prepare('SELECT s.id, s.school_id FROM students s WHERE s.id = ?').get(wanted)
+  : db.prepare('SELECT s.id, s.school_id FROM students s WHERE EXISTS (SELECT 1 FROM grades g WHERE g.student_id = s.id) ORDER BY s.id LIMIT 1').get();
+if (!row) { console.error("Aucun élève avec des notes. Lance d'abord : npm run seed"); process.exit(1); }
+
+const school = db.prepare('SELECT * FROM schools WHERE id = ?').get(row.school_id);
+const term = db.prepare("SELECT id FROM terms WHERE school_id = ? AND status != 'upcoming' ORDER BY position DESC LIMIT 1").get(row.school_id);
+const report = buildReport(row.school_id, row.id, term.id, 'fr');
+
+const out = path.join(config.root, 'data', 'apercu-bulletin.pdf');
+const doc = createBulletinDoc({ school, reports: [report], lang: 'fr' });
+doc.pipe(fs.createWriteStream(out)).on('finish', () => console.log(`Aperçu créé : ${out}\n(${report.student.last_name} ${report.student.first_name} — ${report.term.name})`));
+doc.end();
