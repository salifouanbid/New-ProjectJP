+const PLANS = { trial: 0, starter: 12900, school: 29900, plus: 54900, network: 0 };
+
+// Change la formule et la limite d'élèves d'un établissement
+router.patch('/schools/:id/plan', (req, res) => {
+  const s = db.prepare('SELECT * FROM schools WHERE id = ?').get(req.params.id);
+  if (!s) throw notFound();
+  const plan = str(req.body && req.body.plan, 20);
+  if (!(plan in PLANS)) throw bad('Formule inconnue');
+  const limit = parseInt(req.body.student_limit, 10);
+  if (!(limit >= 1 && limit <= 100000)) throw bad("Limite d'élèves invalide");
+  db.prepare('UPDATE schools SET plan = ?, student_limit = ? WHERE id = ?').run(plan, limit, s.id);
+  res.json({ ok: true });
+});
+
+// Enregistre un paiement d'abonnement et prolonge la période payée (à partir d'aujourd'hui ou de la fin déjà payée)
+router.post('/schools/:id/payments', (req, res) => {
+  const s = db.prepare('SELECT * FROM schools WHERE id = ?').get(req.params.id);
+  if (!s) throw notFound();
+  const b = req.body || {};
+  const amount = parseInt(b.amount, 10);
+  const months = parseInt(b.months, 10);
+  if (!(amount >= 0)) throw bad('Montant invalide');
+  if (!(months >= 1 && months <= 24)) throw bad('Durée invalide (1 à 24 mois)');
+  const today = new Date().toISOString().slice(0, 10);
+  const from = s.paid_until && s.paid_until > today ? s.paid_until : today;
+  const d = new Date(from + 'T12:00:00Z');
+  d.setUTCMonth(d.getUTCMonth() + months);
+  const to = d.toISOString().slice(0, 10);
+  db.transaction(() => {
+    db.prepare('INSERT INTO platform_payments (school_id, amount, method, reference, months, period_from, period_to) VALUES (?,?,?,?,?,?,?)')
+      .run(s.id, amount, str(b.method, 30), str(b.reference, 80), months, from, to);
+    db.prepare("UPDATE schools SET paid_until = ?, plan = CASE WHEN plan = 'trial' THEN ? ELSE plan END WHERE id = ?").run(to, str(b.plan, 20) in PLANS && str(b.plan, 20) !== 'trial' ? str(b.plan, 20) : 'starter', s.id);
+  })();
+  res.status(201).json({ paid_until: to });
+});
+
+// Tableau de bord du propriétaire : revenu récurrent mensuel (estimé) et encaissements des 12 derniers mois
+router.get('/revenue', (req, res) => {
+  const active = db.prepare("SELECT plan, COUNT(*) n FROM schools WHERE active = 1 GROUP BY plan").all();
+  const mrr = active.reduce((sum, r) => sum + (PLANS[r.plan] || 0) * r.n, 0);
+  const cashed = db.prepare("SELECT COALESCE(SUM(amount),0) total FROM platform_payments WHERE created_at >= datetime('now','-12 months')").get().total;
+  res.json({ mrr_estimate: mrr, schools_by_plan: active, cashed_last_12_months: cashed, prices: PLANS });
+});
+
 module.exports = router;
