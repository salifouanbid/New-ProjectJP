# ===== Copie ce fichier en ".env" puis adapte les valeurs =====

# Port du serveur
PORT=3000

# "development" en local, "production" une fois en ligne (HTTPS)
NODE_ENV=development

# OBLIGATOIRE en production : une longue phrase secrète aléatoire (32+ caractères)
# Générer :  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# URL publique du site (utilisée dans les emails de réinitialisation)
APP_URL=http://localhost:3000

# Fournisseur actif. L'application actuelle reste sur SQLite tant que les routes
# synchrones ne sont pas migrées ; voir MIGRATION_STATUS.md.
DB_PROVIDER=sqlite

# SQLite local (configuration par défaut, toujours fonctionnelle)
DB_PATH=./data/portail.db
UPLOAD_DIR=./uploads

# PostgreSQL/Supabase côté serveur uniquement. Ne jamais exposer DATABASE_URL au navigateur
# ni la préfixer par NEXT_PUBLIC_. Utiliser le pooler transactionnel (port 6543) sur Vercel.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
# DATABASE_POOL_MAX=1
# DATABASE_IDLE_TIMEOUT_MS=5000
# DATABASE_CONNECT_TIMEOUT_MS=10000

# Compte "propriétaire de la plateforme" (créé automatiquement au 1er démarrage)
# Si tu laisses vide, un mot de passe aléatoire est généré et affiché dans la console.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# Cookies "secure" (HTTPS obligatoire). Par défaut : true si NODE_ENV=production
# COOKIE_SECURE=true

# Email (réinitialisation de mot de passe). Sans SMTP, le lien s'affiche dans la console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portail Scolaire <no-reply@exemple.bj>"

# Nombre de proxys devant l'application (Nginx = 1, Cloudflare + Nginx = 2, accès direct = 0). Défaut : 1 en production.
# TRUST_PROXY=1

# Sauvegardes (npm run backup) : dossier et nombre de sauvegardes conservées
# BACKUP_DIR=./backups
# BACKUP_KEEP=14

# Pilote SQLite : auto | better-sqlite3 | node
# auto = node:sqlite avec Node >= 22 ; sinon essaie better-sqlite3.
DB_DRIVER=auto
